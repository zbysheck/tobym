{
    "manifest_version": 3,
    "name": "Tobym",
    "description": "Dodaj prezent do swojej listy Tobym z dowolnego sklepu. Uzupełnia też dane ze sklepów, które blokują serwer.",
    "version": "0.2.0",
    "action": {
        "default_title": "Dodaj do listy Tobym",
        "default_popup": "popup.html"
    },
    "permissions": ["activeTab", "scripting", "storage"],
    "host_permissions": ["https://*/*", "http://*/*"],
    "content_scripts": [
        {
            "matches": [
                "https://tobym.zbigniewkisly.usermd.net/addon/connect*",
                "http://tobym.test/addon/connect*"
            ],
            "js": ["connect.js"]
        },
        {
            "matches": [
                "https://tobym.zbigniewkisly.usermd.net/*",
                "http://tobym.test/*"
            ],
            "js": ["bridge.js"],
            "run_at": "document_start"
        }
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    }
}
