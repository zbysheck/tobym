{
    "manifest_version": 3,
    "name": "Tobym",
    "description": "Dodaj prezent do listy Tobym jednym kliknięciem, z dowolnego sklepu.",
    "version": "0.3.0",
    "action": {
        "default_title": "Dodaj ten produkt do Tobym"
    },
    "permissions": ["activeTab", "scripting", "storage"],
    "host_permissions": ["https://*/*", "http://*/*"],
    "content_scripts": [
        {
            "matches": ["https://tobym.zbigniewkisly.usermd.net/*"],
            "js": ["bridge.js"],
            "run_at": "document_start"
        }
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    }
}
