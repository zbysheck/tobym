{
    "manifest_version": 3,
    "name": "Tobym",
    "description": "Dodaj prezent do swojej listy Tobym z dowolnego sklepu jednym kliknięciem.",
    "version": "0.1.0",
    "action": {
        "default_title": "Dodaj do listy Tobym",
        "default_popup": "popup.html"
    },
    "permissions": ["activeTab", "scripting", "storage"],
    "host_permissions": [
        "https://tobym.zbigniewkisly.usermd.net/*",
        "http://tobym.test/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://tobym.zbigniewkisly.usermd.net/addon/connect*",
                "http://tobym.test/addon/connect*"
            ],
            "js": ["connect.js"]
        }
    ]
}
